{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.sunsetvillagesf.com"
        }
      ],
      "destination": "https://sunsetvillagesf.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sunsetvillage.vercel.app"
        }
      ],
      "destination": "https://sunsetvillagesf.com/$1",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/calendar-sync",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/voice-cron",
      "schedule": "0 13 * * 0,1"
    },
    {
      "path": "/api/voice-cron/retry",
      "schedule": "0 14 * * 0,1"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "framework": "nextjs"
}
